---
import imageservicios from "../../assets/happy-clients-buying-poke-bowl-2022-09-29-21-15-22-utc.png";
import mapachelogo from "../../assets/logo2recortado.png";
import Button from "../Button.astro"
---

<section id="diseno" class="bg-[#d0cfe6] px-4 sm:px-10 py-12 sm:py-20 max-w-full mt-2 mb-2">
  <div class="flex flex-col-reverse md:flex-row md:justify-between md:items-center gap-10">
    
    <div class="flex flex-col gap-8 md:gap-12 max-w-xl text-center md:text-left items-center md:items-start">
      <div>
        <img
          class="w-28 sm:w-36 md:w-[190px] h-auto mx-auto md:mx-0"
          src={mapachelogo.src}
          alt="Mapache Logo"
        />
      </div>

      <div>
        <strong class="text-xl sm:text-2xl block">Servicio estrella</strong>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold leading-tight">
          Diseño de servicios
        </h1>
      </div>

      <div class="text-sm sm:text-base">
        <p>Costo: $xx + IVA</p>
        <p>Tiempo estimado: xxx días hábiles</p>
        <p>Entregables: xxx</p>
      </div>

      <div class="mt-6 sm:mt-10">
        <Button 
          label="¡Quiero un diagnóstico de marca!" 
          bgColor="bg-boton-servicios" 
          textColor="text-texBoton"
        ></Button>
      </div>
    </div>

    <div class="p-2 mt-6 md:mt-0 flex justify-center md:justify-end">
      <img
        src={imageservicios.src}
        alt="Imagen de servicios"
        class="w-40 h-40 sm:w-56 sm:h-56 md:w-[350px] md:h-[350px] lg:w-[450px] lg:h-[450px] rounded-full object-cover"
      />
    </div>
  </div>
</section>

