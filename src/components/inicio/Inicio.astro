---
import imagen from '../../assets/IMG.png';
import Button from '../Button.astro';
---

<section id="inicio" class="w-full sm:px-8 flex flex-col md:flex-row justify-between gap-6 space-y-6">  
  <!--abajo estan los textos-->
   <section class="w-full max-w-full md:max-w-[500px] grid gap-4 auto-rows-max m-4">
    <h1 class="text-3xl sm:text-4xl   md:text-5xl leading-snug sm:leading-tigh font-medium text-foreground/60 mb-2">
      ¿Tus colaboradores saben qué decir y hacer?
    </h1>
    <strong class="text-xl">Estandarizamos la atención al cliente.</strong>
    <p class="text-muted md:w-1/2">
        Una empresa rentable es aquella que confia en sus colaboradores y procesos para que
		tu marca siempre se vea y se sienta en todos los puntos de contacto.
    </p>
   </section>
<!--abajo esta para la imagen-->
<div class="flex intems-center justify-center m-4 space ">
    <div class="md:w-[500px] md:h-[500px] rounded-full w-[320px] h-[320px] overflow-hidden bg-[#fb43c5] ">
        <img 
        src={imagen.src} alt="imagen de inicio"
        class="w-full h-full object-cover object-[5px] "/>
    </div>
</div>
</section>
<div class="px-14  intems-center justify-center space-y-8 mb-10">
  
<Button label="Diseño de Servicios"/>
</div>

